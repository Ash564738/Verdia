APP_ENV=development
LOG_LEVEL=DEBUG
SECRET_KEY=generate-a-long-random-secret
CORS_ORIGINS=http://localhost:5173
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=generate-a-unique-admin-password
# Copy the PostgreSQL connection string from Supabase Dashboard > Connect.
# Use the connection mode/host shown there and add sslmode=require.
DATABASE_URL=postgresql://postgres:YOUR_DATABASE_PASSWORD@YOUR_DATABASE_HOST:5432/postgres?sslmode=require
# Create a PRIVATE bucket in Supabase Storage and set this to its exact bucket name.
STORAGE_BACKEND=s3
S3_BUCKET=plant-care-private
# Copy the endpoint, region, access key and secret key from Supabase Storage S3 settings.
S3_REGION=YOUR_SUPABASE_STORAGE_REGION
S3_ENDPOINT=https://YOUR_PROJECT_REF.storage.supabase.co/storage/v1/s3
S3_ACCESS_KEY=YOUR_ROTATED_S3_ACCESS_KEY
S3_SECRET_KEY=YOUR_ROTATED_S3_SECRET_KEY
